{
  "name": "@makrozai/nayra-storybook",
  "version": "1.0.1",
  "private": false,
  "type": "module",
  "main": "dist/nayra-storybook.js",
  "module": "dist/nayra-storybook.js",
  "types": "dist/index.d.ts",
  "style": "dist/style.css",
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nayra-storybook.js",
      "require": "./dist/nayra-storybook.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:storybook": "test-storybook --url http://localhost:6006",
    "test:storybook:ci": "test-storybook --url http://localhost:6006 --ci",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/test-runner": "^0.24.4",
    "@storybook/vue3": "^10.4.0",
    "@storybook/vue3-vite": "^10.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.6",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.0",
    "eslint-plugin-storybook": "10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "happy-dom": "^20.9.0",
    "storybook": "^10.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.6",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.1"
  }
}
